{
  "nombre": "listia",
  "version": "1.1",
  "autor": "Yonijd",
  "copyright": "Copyright (c) 2026 Yonijd",
  "licencia": "MIT",
  "categoria": "sistema",
  "tags": ["listar", "directorio", "archivos", "carpetas", "json", "ia"],
  "descripcion": "Lista el contenido de un directorio en formato JSON estructurado. Optimizado para consumo por IA. Soporta control de profundidad y archivos ocultos.",
  "tipo": "script",
  "dependencias": {},
  "script": "listia.py",
  "ruta_script": "skills/listia/listia.py",
  "alias": ["explorar", "explore", "tree_json", "scan"],
  "parametros": {
    "ruta": {
      "tipo": "string",
      "requerido": false,
      "descripcion": "Ruta del directorio a listar (default: .)",
      "defecto": "."
    },
    "profundidad": {
      "tipo": "number",
      "requerido": false,
      "descripcion": "Profundidad maxima a listar (default: 1, 0 = todos los niveles sin limite)",
      "defecto": 1
    },
    "incluir_ocultos": {
      "tipo": "boolean",
      "requerido": false,
      "descripcion": "Incluir carpetas y archivos ocultos (default: false)",
      "defecto": false
    },
    "detalles": {
      "tipo": "boolean",
      "requerido": false,
      "descripcion": "Calcular tamaños de carpetas, extensiones y estadisticas.",
      "defecto": false
    }
  },
  "usage": ["ruta (opcional)", "profundidad (opcional)", "incluir_ocultos (opcional)", "detalles (opcional)"],
  "ejemplo": {
    "comando": "listia",
    "ruta": "skills",
    "profundidad": 2
  },
  "ejemplos_adicionales": [
    {
      "descripcion": "Listar el workdir con profundidad 1",
      "json": {
        "comando": "listia",
        "ruta": ".",
        "profundidad": 1
      }
    },
    {
      "descripcion": "Listar con detalles y estadisticas",
      "json": {
        "comando": "listia",
        "ruta": "skills",
        "profundidad": 2,
        "detalles": true
      }
    },
    {
      "descripcion": "Incluir archivos ocultos",
      "json": {
        "comando": "listia",
        "ruta": ".",
        "incluir_ocultos": true
      }
    }
  ],
  "perfil_minimo": "solo_lectura",
  "nota": "Funciona con 'listia' directo o con 'ejecutar'. Usa workdir para rutas relativas."
}

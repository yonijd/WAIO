      "tipo": "number",
      "requerido": false,
      "descripcion": "Profundidad maxima a analizar (default: 3)",
      "defecto": 3
    }
  },
  "usage": ["ruta (opcional)", "profundidad (opcional)"],
  "ejemplo": {
    "comando": "analizar_proyecto",
    "ruta": ".",
    "profundidad": 2
  },
  "ejemplos_adicionales": [
    {
      "descripcion": "Analizar directorio actual",
      "json": {
        "comando": "analizar_proyecto",
        "ruta": "."
      }
    },
    {
      "descripcion": "Usar alias analizar",
      "json": {
        "comando": "analizar",
        "ruta": "tests",
        "profundidad": 1
      }
    }
  ],
  "perfil_minimo": "solo_lectura",

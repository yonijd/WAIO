  "autor": "WAIOGG",
  "categoria": "comandos_base",
  "tags": ["leer", "lineas", "rango", "archivo", "texto"],
  "descripcion": "Lee un rango especifico de lineas de un archivo",
  "tipo": "comando_interno",
  "alias": ["head", "read_lines"],

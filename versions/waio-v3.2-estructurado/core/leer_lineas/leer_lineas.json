    "ruta": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta del archivo"
    },
    "inicio": {
      "tipo": "number",
      "requerido": false,
      "descripcion": "Numero de linea inicial",
      "defecto": 1
    },
    "fin": {
      "tipo": "number",
      "requerido": true,
      "descripcion": "Numero de linea final"
    }
  },
  "perfil_minimo": "solo_lectura",
  "ejemplo": {
    "comando": "leer_lineas",
    "ruta": "archivo.py",
    "inicio": 10,
    "fin": 20
  }
}
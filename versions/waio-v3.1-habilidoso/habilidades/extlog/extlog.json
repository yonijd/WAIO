{
  "nombre": "extlog",
  "version": "1.0",
  "autor": "Yonijd",
  "categoria": "sistema",
  "tags": ["analisis", "archivo", "hash", "metadatos", "exif", "profundo"],
  "descripcion": "Analiza un archivo en profundidad: hashes, metadatos, estructura interna (texto, imagen, ejecutable, PDF, ZIP, RAR).",
  "tipo": "script",
  "dependencias": {
    "pillow": "10.0.0",
    "pypdf": "4.0.0",
    "pywin32": "306",
    "rarfile": "4.2"
  },
  "script": "extlog.py",
  "parametros": {
    "ruta": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta del archivo a analizar"
    },
    "guardar_log": {
      "tipo": "boolean",
      "requerido": false,
      "descripcion": "Guardar log en .ialogpack/logs/"
    }
  },
  "ejemplo": {
    "comando": "ejecutar_script",
    "script": "extlog.py",
    "parametros": ["--ruta=archivo.pdf"]
  },
  "perfil_minimo": "solo_lectura"
}
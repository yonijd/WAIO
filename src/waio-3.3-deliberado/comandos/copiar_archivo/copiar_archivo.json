    "destino": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta de destino"
    }
  },
  "usage": ["origen", "destino"],
  "timeout_segundos": 120,
  "ejemplo": {
    "comando": "copiar_archivo",
    "origen": "archivo.txt",
    "destino": "backup/archivo.txt"
  },

  "categoria": "comandos_base",
  "tags": ["append", "agregar", "archivo", "final", "escribir"],
  "descripcion": "Agrega contenido al final de un archivo existente",
  "tipo": "comando_interno",
  "alias": ["agregar", "append"],
  "parametros": {
    "ruta": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta del archivo"
    },
    "contenido": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Contenido a agregar"
    }
  },
  "usage": ["ruta", "contenido"],
  "timeout_segundos": 60,
  "ejemplo": {
    "comando": "append_archivo",
    "ruta": "log.txt",
    "contenido": "Nueva linea al final"
  },
  "ejemplos_adicionales": [],
  "perfil_minimo": "standard",
  "nota": "Agrega al final sin sobreescribir. No inserta salto de linea automatico."
}

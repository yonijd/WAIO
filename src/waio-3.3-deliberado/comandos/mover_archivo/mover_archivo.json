{
  "nombre": "mover_archivo",
  "version": "1.1",
  "autor": "Yonijd",
  "copyright": "Copyright (c) 2026 Yonijd",
  "licencia": "MIT",
  "categoria": "comandos_base",
  "tags": ["mover", "archivo", "renombrar", "trasladar"],
  "descripcion": "Mueve o renombra un archivo",
  "tipo": "comando_interno",
  "alias": ["mover", "mv", "move"],
  "parametros": {
    "origen": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta de origen"
    },
    "destino": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta de destino"
    }
  },
  "usage": ["origen", "destino"],
  "timeout_segundos": 120,
  "ejemplo": {
    "comando": "mover_archivo",
    "origen": "archivo.txt",
    "destino": "backup/archivo.txt"
  },
  "ejemplos_adicionales": [],
  "perfil_minimo": "standard",
  "nota": "Si destino es una carpeta, mueve el archivo dentro. Si destino incluye nombre, renombra. Crea carpetas padre si no existen."
}

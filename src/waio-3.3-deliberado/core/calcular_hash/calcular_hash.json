{
  "nombre": "calcular_hash",
  "version": "1.1",
  "autor": "Yonijd",
  "copyright": "Copyright (c) 2026 Yonijd",
  "licencia": "MIT",
  "categoria": "utilidades",
  "tags": ["hash", "sha256", "md5", "sha1", "archivo", "checksum"],
  "descripcion": "Calcula el hash (SHA-256, MD5, etc.) de un archivo o carpeta",
  "tipo": "script",
  "dependencias": {},
  "script": "calcular_hash.py",
  "ruta_script": "core/calcular_hash/calcular_hash.py",
  "alias": ["hash", "checksum"],
  "parametros": {
    "ruta": {
      "tipo": "string",
      "requerido": true,
      "descripcion": "Ruta del archivo o carpeta"
    },
    "algoritmo": {
      "tipo": "string",
      "requerido": false,
      "descripcion": "Algoritmo: sha256, md5, sha1, etc.",
      "defecto": "sha256"
    },
    "resumen": {
      "tipo": "boolean",
      "requerido": false,
      "descripcion": "Mostrar solo resumen (para carpetas)"
    }
  },
  "usage": ["ruta", "algoritmo (opcional)", "resumen (opcional)"],
  "ejemplo": {
    "comando": "calcular_hash",
    "ruta": "archivo.pdf",
    "algoritmo": "md5"
  },
  "ejemplos_adicionales": [
    {
      "descripcion": "Hash SHA-256 de un archivo",
      "json": {
        "comando": "calcular_hash",
        "ruta": "tests/prueba_abrir.txt"
      }
    },
    {
      "descripcion": "Usar alias hash con MD5",
      "json": {
        "comando": "hash",
        "ruta": "tests/prueba_abrir.txt",
        "algoritmo": "md5"
      }
    }
  ],
  "perfil_minimo": "standard",
  "timeout_segundos": 120,
  "nota": "Funciona con 'calcular_hash' directo o con 'ejecutar'. Usa workdir para rutas relativas."
}
